      "source": [
        "#@title Aplikasi Kasir Kantin RPL\n",
        "nama_pembeli = \"Pino\" #@param {type:'string'}\n",
        "menu_makanan = \"Nasi Goreng Spesial\" #@param [\"Nasi Goreng Spesial\", \"Mie Ayam Bakso\", \"Soto Ayam\"]\n",
        "harga_satuan = 15000 #@param {type:'integer'}\n",
        "jumlah_porsi = 2 #@param {type:'slider', min:1, max:10, step:1}\n",
        "uang_dibayar = 50000 #@param {type:'integer'}\n",
        "\n",
        "# LENGKAPI RUMUS DI BAWAH INI:\n",
        "total_belanja = harga_satuan * jumlah_porsi\n",
        "uang_kembalian = uang_dibayar - total_belanja\n",
        "\n",
        "# Menampilkan Struk Belanja\n",
        "print(\"========================================\")\n",
        "print(\"         STRUK KANTIN SMK RPL          \")\n",
        "print(\"========================================\")\n",
        "print(f\"Nama Pembeli : {nama_pembeli}\")\n",
        "print(f\"Menu Pesanan : {menu_makanan}\")\n",
        "print(f\"Harga Satuan : Rp{harga_satuan}\")\n",
        "print(f\"Jumlah Porsi : {jumlah_porsi} porsi\")\n",
        "print(\"----------------------------------------\")\n",
        "print(f\"TOTAL BELANJA : Rp{total_belanja}\")\n",
        "print(f\"UANG TUNAI    : Rp{uang_dibayar}\")\n",
        "print(f\"UANG KEMBALIAN : Rp{uang_kembalian}\")\n",
        "print(\"========================================\")"
      ]
